# Copy to .env (setup does this for you) and fill in what applies.
# This file is sourced by bin/r2, so keep every value quoted and avoid < > characters.
#
# ALL OF THIS IS OPTIONAL. A workspace with no storage configured works fine —
# large files simply stay on your machine.

# Your email — becomes your folder, so you can't overwrite a colleague's files.
R2_USER_EMAIL=""

# S3-compatible credentials — Cloudflare R2, AWS S3, Backblaze B2 all work.
R2_ACCESS_KEY_ID=""
R2_SECRET_KEY=""
R2_ENDPOINT=""

# Bucket to store in. R2_BUCKET_PUBLIC defaults to the same bucket; set it
# separately only if you keep shared files somewhere else.
R2_BUCKET_PRIVATE=""
R2_BUCKET_PUBLIC=""

# How long `r2 share` links stay valid, in seconds. Default 86400 (1 day).
# 604800 (7 days) is the maximum any signed URL can last.
R2_SHARE_TTL="86400"

# ONLY set this if a custom domain serves your bucket to the open internet.
# When set, bin/r2 warns you that nothing in the bucket is actually private,
# because a signed link's expiry means nothing if the plain URL also works.
R2_PUBLIC_BASE=""

# Optional — only if a task's helper scripts call these APIs.
# ANTHROPIC_API_KEY=""
# ELEVENLABS_API_KEY=""
