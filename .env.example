# Copy to .env (./setup.sh does this) and fill in. .env is gitignored.
# This file is sourced by bin/r2, so keep every value quoted and avoid < > characters.

# Your email — this becomes your folder in R2. Everything ./bin/r2 writes
# goes under it, so you can't overwrite a colleague's files by mistake.
R2_USER_EMAIL="you@bigbongo.ai"

# R2 credentials. Ask Petar for a token scoped to the assistant buckets.
# Replace ACCOUNT_ID in the endpoint with the account id from the R2 dashboard.
R2_ACCESS_KEY_ID=""
R2_SECRET_KEY=""
R2_ENDPOINT="https://ACCOUNT_ID.eu.r2.cloudflarestorage.com"

# Buckets. Private is the default target; public is only used by `r2 share`.
R2_BUCKET_PRIVATE="assistant-team"
R2_BUCKET_PUBLIC="assistant"
R2_PUBLIC_BASE="https://assistant.bigbongo.ai"

# Optional — only if a task's helper scripts call these APIs.
# ANTHROPIC_API_KEY=""
# ELEVENLABS_API_KEY=""
