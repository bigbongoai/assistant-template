# Copy to .env (setup does this for you) and fill in what applies.
# This file is sourced by bin/r2, so keep every value quoted and avoid < > characters.
#
# ALL OF THIS IS OPTIONAL. A workspace with no storage configured works fine —
# large files simply stay on your machine.

# Your email — becomes your folder, so you can't overwrite a colleague's files.
R2_USER_EMAIL=""

# S3-compatible credentials. Big Bongo people: ask Petar.
# Anyone else: Cloudflare R2, AWS S3, Backblaze B2 and friends all work here.
R2_ACCESS_KEY_ID=""
R2_SECRET_KEY=""
R2_ENDPOINT=""

# Bucket names. Big Bongo currently uses ONE bucket for both, and it is served
# on a public custom domain — so anything uploaded is readable by anyone with
# the URL. bin/r2 says so on every upload while these two match.
R2_BUCKET_PRIVATE="assistant"
R2_BUCKET_PUBLIC="assistant"

# Public base URL for `r2 share` links. Leave empty if your bucket has no
# public domain — `share` will tell you instead of printing a dead link.
R2_PUBLIC_BASE="https://assistant.bigbongo.ai"

# Optional — only if a task's helper scripts call these APIs.
# ANTHROPIC_API_KEY=""
# ELEVENLABS_API_KEY=""
