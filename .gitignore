# Secrets — never commit
.env
.env.*
!.env.example

# Onboarding form output — contains R2 keys, deleted after setup applies it
setup/answers.json

# Organisation overlay — org settings and possibly storage credentials.
# Handed out internally; never belongs in a shared repo.
assistant.config.local.json

# Claude's throwaway artifacts inside tasks (raw scrapes, Playwright snapshots,
# scratch JSON). Your actual task work IS tracked — only temp/ is skipped.
tasks/**/temp/

# Dependencies
node_modules/

# Claude Code / MCP runtime state
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Ask AI per-page thread databases — local state, one per HTML deliverable
*.askai.sqlite3
*.askai.sqlite3-wal
*.askai.sqlite3-shm

# --- Brought over from the workspace ---
# Secrets that are files rather than .env variables
*.pem
*.key
id_rsa*
id_ed25519*
# Anything a tool can rebuild
__pycache__/
*.pyc
.venv/
venv/
dist/
.next/
# Local runtime state
.claude/scheduled_tasks.lock
# Throwaway working folders anywhere, not only under tasks/
**/temp/
