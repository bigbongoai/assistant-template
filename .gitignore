# Your tasks are yours — never pushed to the shared repo.
# The folder itself is tracked so a fresh clone has somewhere to work.
tasks/*
!tasks/.gitkeep

# Personal files. Copy the .example versions via ./setup.sh, then edit freely
# without your edits ever conflicting on `git pull`.
_personal.md
_tasks.md

# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Claude Code / MCP runtime state
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
