#!/usr/bin/env python3
"""publish - put a deliverable online, with its Ask AI drawer still working.

A deliverable in an assistant workspace is one self-contained HTML file. Opened
from disk it is just a page; served by the local Ask AI proxy it gains a chat
drawer you can select text in and ask about. Handing someone the file loses the
drawer, because the drawer needs a server.

This sends the page to briefings.page instead, which serves it and runs the
drawer there. The result is a link you can send to anyone.

    ./bin/publish tasks/19.pricing/19-01.research/index.html
    ./bin/publish list
    ./bin/publish rm <id>
    ./bin/publish whoami

It can also keep a private copy of the whole workspace there - every page, the
notes beside them, and the index that lists them - sent again after every
commit. Only you can open it, at your own address on briefings.page, after
signing in; a page in it is public only once you switch it on.

    ./bin/publish mirror on       send it now and after every commit
    ./bin/publish mirror off      stop sending it
    ./bin/publish mirror          where it stands
    ./bin/publish sync            send it now, once

The first time, a browser window opens and asks for an email address. There is
no password and nothing to copy: you approve it in the browser, and this script
collects the credential over its own connection and writes it to .env. The
token is never printed, and never travels through the browser.

Drop this file at bin/publish in the workspace it publishes from. Standard
library only. No install step.
"""
import hashlib
import http.server
import importlib.util
import json
import os
import secrets
import socket
import socketserver
import ssl
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import webbrowser
from html import unescape
from pathlib import Path

try:
    import fcntl
except ImportError:          # Windows, which locks files another way
    fcntl = None

ROOT = Path(__file__).resolve().parent.parent
ENV = ROOT / ".env"

DEFAULT_HOST = "https://briefings.page"
TOKEN_KEY = "BRIEFINGS_TOKEN"
HOST_KEY = "BRIEFINGS_HOST"

# Notes shipped with the page, so the drawer answers as well online as it does
# locally. Same two layers the local proxy reads: the step folder, then the
# task folder.
MAX_NOTES = 40

# Never shipped, whichever folder they sit in. A task's CLAUDE.md is its whole
# internal record - decisions, prices, customer names - written for Claude, and
# a published page is public to anyone holding the link. The local proxy still
# reads it; only this upload leaves it out. Compared case-insensitively.
NEVER_PUBLISHED = {"claude.md"}

USER_AGENT = "briefings-publish/1.1"

# The sync in progress, so that a failure anywhere is written to its log: run
# from a git hook, nobody is watching the terminal.
_run = None


def die(msg, code=1):
    if _run is not None:
        _run.fail(msg)
    print(f"publish: {msg}", file=sys.stderr)
    raise SystemExit(code)


# ----------------------------------------------------------------------- .env


def read_env():
    """KEY=VALUE pairs from .env. Values may be quoted."""
    values = {}
    if not ENV.exists():
        return values
    for raw in ENV.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        if key.startswith("export "):
            key = key[7:].strip()
        values[key] = value.strip().strip('"').strip("'")
    return values


def write_env_value(key, value):
    """Set one key in .env, leaving every other line untouched.

    Never printed, and the file is left readable only by its owner.
    """
    lines = []
    if ENV.exists():
        lines = ENV.read_text(encoding="utf-8", errors="replace").splitlines()
    out, replaced = [], False
    for line in lines:
        stripped = line.strip()
        name = stripped.split("=", 1)[0].strip() if "=" in stripped else ""
        if name.startswith("export "):
            name = name[7:].strip()
        if name == key and not stripped.startswith("#"):
            out.append(f'{key}="{value}"')
            replaced = True
        else:
            out.append(line)
    if not replaced:
        if out and out[-1].strip():
            out.append("")
        out.append("# Publishing to briefings.page. Written by ./bin/publish - do not share.")
        out.append(f'{key}="{value}"')
    ENV.write_text("\n".join(out) + "\n", encoding="utf-8")
    ENV.chmod(0o600)


def host():
    return (read_env().get(HOST_KEY) or os.environ.get(HOST_KEY)
            or DEFAULT_HOST).rstrip("/")


def saved_token():
    return read_env().get(TOKEN_KEY) or os.environ.get(TOKEN_KEY, "")


# ------------------------------------------------------------------- http


def api(path, payload=None, token=None, method=None, timeout=60, raw=None):
    """One call. Sends JSON, or `raw` bytes. Returns (status, parsed-body)."""
    url = f"{host()}{path}"
    # Name ourselves. Cloudflare's bot rules refuse the default
    # "Python-urllib/3.x" outright, so without this every call is a 403 that
    # looks like a server fault.
    headers = {"Accept": "application/json", "User-Agent": USER_AGENT}
    if raw is not None:
        data = raw
        headers["Content-Type"] = "application/octet-stream"
    else:
        data = json.dumps(payload).encode("utf-8") if payload is not None else None
        if data is not None:
            headers["Content-Type"] = "application/json"
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(
        url, data=data, headers=headers,
        method=method or ("POST" if data is not None else "GET"))
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode("utf-8") or "{}")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", "replace")
        try:
            return exc.code, json.loads(body or "{}")
        except json.JSONDecodeError:
            return exc.code, {"error": "http_error", "detail": body[:300]}
    except (urllib.error.URLError, ssl.SSLError, TimeoutError) as exc:
        die(f"could not reach {host()} ({exc}). Are you online?")


def refused(status, body, doing):
    """One sentence for a call that did not work."""
    if status == 401:
        return ("this workspace's credential was refused. Remove BRIEFINGS_TOKEN "
                "from .env and run it again to sign in.")
    return f"{doing}: {body.get('detail') or body.get('error') or f'status {status}'}"


# ------------------------------------------------------- signing in (once)


class _Callback(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True
    approved = threading.Event()


class _CallbackHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.server.approved.set()
        body = (
            b"<!doctype html><meta charset=utf-8>"
            b"<title>Done</title>"
            b"<body style='font:16px system-ui;padding:3rem;text-align:center'>"
            b"<h1>All set</h1><p>You can close this tab and go back to your assistant.</p>"
        )
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass  # keep the terminal readable


def sign_in():
    """Device authorization: approve in a browser, collect the token here.

    The browser only ever carries a public request id. The token itself comes
    back over this script's own HTTPS connection, so it never appears in a URL,
    a history entry, or on screen.
    """
    server = _Callback(("127.0.0.1", 0), _CallbackHandler)
    port = server.server_address[1]
    state = secrets.token_urlsafe(16)
    threading.Thread(target=server.serve_forever, daemon=True).start()

    status, body = api("/api/publish/auth/start", {
        "redirect_uri": f"http://127.0.0.1:{port}/callback",
        "state": state,
        "name": socket.gethostname(),
    })
    if status != 200:
        die(f"could not start sign-in: {body.get('detail') or body.get('error')}")

    device_code = body["device_code"]
    approve_url = body["approve_url"]
    interval = max(1, int(body.get("interval") or 2))
    deadline = time.time() + int(body.get("expires_in") or 900)

    print("Opening your browser to finish setting this up.")
    print("If it does not open, go to:")
    print(f"  {approve_url}\n")
    try:
        webbrowser.open(approve_url)
    except Exception:
        pass

    print("Waiting for you to approve it...", flush=True)
    while time.time() < deadline:
        server.approved.wait(timeout=interval)
        status, body = api("/api/publish/auth/token", {"device_code": device_code})
        if status == 200:
            server.shutdown()
            write_env_value(TOKEN_KEY, body["token"])
            print(f"\nSigned in as {body['email']} ({body.get('plan', 'free')} plan).")
            print("Saved to .env. You will not have to do this again.")
            return body["token"]
        if status == 202:
            continue
        server.shutdown()
        die(f"sign-in failed: {body.get('detail') or body.get('error')}")

    server.shutdown()
    die("timed out waiting for approval. Run the same command again.")


def token_or_sign_in():
    existing = saved_token()
    if existing:
        return existing
    print("This workspace has not published anything yet, so let's set that up.\n")
    return sign_in()


# --------------------------------------------------------------- the page


def label(path):
    """The path as written in the workspace, for showing to a person."""
    try:
        return str(path.resolve().relative_to(ROOT))
    except ValueError:
        return str(path)


def describe(path):
    """Work out the task and step from where the file sits.

    tasks/19.pricing/19-01.research/index.html
      -> task "19.pricing", step "19-01.research"
    """
    try:
        rel = path.resolve().relative_to(ROOT)
    except ValueError:
        return path.stem, ""
    parts = rel.parts
    if len(parts) >= 3 and parts[0] in ("tasks", "archive", "examples"):
        return parts[1], "/".join(parts[2:-1])
    return (parts[0] if parts else path.stem), "/".join(parts[1:-1])


def page_title(html):
    """The page's own <title>, as text.

    Entities are decoded, so a title written as "Offer &amp; Contract" arrives
    as "Offer & Contract" rather than showing the raw entity to a reader.
    """
    lowered = html.lower()
    start = lowered.find("<title")
    if start == -1:
        return ""
    start = lowered.find(">", start)
    end = lowered.find("</title>", start)
    if start == -1 or end == -1:
        return ""
    return " ".join(unescape(html[start + 1:end]).split())[:300]


def collect_notes(path):
    """The .md files beside the page, plus the ones at the top of its task."""
    folders = [path.parent]
    task_root = path.parent
    try:
        rel = path.resolve().relative_to(ROOT)
        if len(rel.parts) >= 3 and rel.parts[0] in ("tasks", "archive", "examples"):
            task_root = ROOT / rel.parts[0] / rel.parts[1]
    except ValueError:
        pass
    if task_root != path.parent:
        folders.append(task_root)

    notes, seen = [], set()
    for folder in folders:
        for md in sorted(folder.glob("*.md")):
            if md in seen or md.name.lower() in NEVER_PUBLISHED:
                continue
            seen.add(md)
            try:
                notes.append({
                    "name": label(md),
                    "body": md.read_text(encoding="utf-8", errors="replace"),
                })
            except OSError:
                continue
    return notes[:MAX_NOTES]


def cmd_publish(arg):
    # Resolve up front: everything downstream compares against the workspace
    # root, and a relative path passed on the command line would not match.
    path = Path(arg).resolve()
    if path.is_dir():
        path = path / "index.html"
    if not path.is_file():
        die(f"no such file: {arg}")
    if path.suffix.lower() != ".html":
        die("publish takes an .html file (the deliverable itself)")

    html = path.read_text(encoding="utf-8", errors="replace")
    task, step = describe(path)
    notes = collect_notes(path)

    token = token_or_sign_in()
    print(f"\nPublishing {label(path)} ...")
    status, body = api("/api/publish/pages", {
        "task": task, "step": step,
        # Which file it is, so a page already in the workspace copy is the one
        # made public, rather than a second copy of it.
        "rel": label(path),
        "title": page_title(html) or path.stem,
        "html": html, "notes": notes,
    }, token=token, timeout=120)

    if status in (200, 201):
        print(f"\n  {body['url']}\n")
        if body.get("pending"):
            # The address is final but not resolving yet. Say so plainly rather
            # than hand over a link that looks fine and does not open.
            print(body.get("pending_detail")
                  or "Saved, but the address is not resolving yet. Try it shortly.")
        else:
            print("Updated." if body.get("updated") else "Live.", end=" ")
            print(f"Using {body['live_pages']} of {body['max_live_pages']} pages.")
        if notes:
            print(f"Ask AI is grounded in {len(notes)} note file(s) from this task.")
        return
    if status == 409 and body.get("error") == "no_handle":
        die(body.get("detail") or "this account has no publishing address yet")
    if status == 402:
        # The only place money is ever mentioned.
        print(f"\n{body.get('detail')}", file=sys.stderr)
        print("\nTo free a slot:  ./bin/publish list   then   ./bin/publish rm <id>",
              file=sys.stderr)
        raise SystemExit(2)
    if status == 401:
        die(refused(status, body, ""))
    die(body.get("detail") or body.get("error") or f"failed with status {status}")


def cmd_list():
    status, body = api("/api/publish/pages", token=token_or_sign_in())
    if status != 200:
        die(body.get("detail") or body.get("error") or "could not list pages")
    pages = body.get("pages") or []
    if not pages:
        print("Nothing published yet.")
        return
    for page in pages:
        mark = "live" if page["live"] else "  - "
        where = page["task"] + (f" / {page['step']}" if page["step"] else "")
        print(f"{mark}  {page['slug']:<14}{where}")
        print(f"        {page['url']}")


def cmd_rm(slug):
    status, body = api(f"/api/publish/pages/{slug}", token=token_or_sign_in(),
                       method="DELETE")
    if status != 200:
        die(body.get("detail") or body.get("error") or "could not take that page down")
    print(f"{slug} is no longer served. Its slot is free again.")


def cmd_whoami():
    status, body = api("/api/publish/me", token=token_or_sign_in())
    if status != 200:
        die(body.get("detail") or body.get("error") or "could not read the account")
    print(f"{body['email']}  ({body['plan']} plan)")
    print(f"{body['live_pages']} of {body['max_live_pages']} pages live")
    copy = body.get("workspace")
    if copy and copy.get("synced_at"):
        print(f"Workspace copy: {copy['files']} files, last sent {copy['synced_at'][:16].replace('T', ' ')} UTC")


# ------------------------------------------------------ the workspace copy
#
# `sync` sends the whole workspace, and only what changed: it lists every file
# with the SHA-256 of its bytes, briefings.page answers with the ones it does
# not have, those go up one per request, and a last call swaps the new version
# in all at once. `mirror on` adds one line to two git hooks so that happens,
# in the background, after every commit and every merge.

COPY_DIRS = ("tasks", "archive", "examples")
# The index's own page code, which draws the copy's index as it is drawn here.
COPY_UI = ("askai.js", "askai.css", "index.js", "index.css", "task.js", "task.css")
# Never sent. The server refuses the same (apps/publish/workspace.py); they are
# left out here first so nothing is sent only to be turned away.
SKIP_PARTS = {"temp", "node_modules", "__pycache__"}
SKIP_SUFFIXES = (".py", ".pyc", ".env")
# The server's ceiling for one file.
MAX_FILE_BYTES = 25 * 1024 * 1024

HOOKS = ("post-commit", "post-merge")
HOOK_MARK = "# briefings.page workspace copy - bin/publish mirror"
HOOK_LINE = ('"$(git rev-parse --show-toplevel)/bin/publish" sync --quiet '
             f'>/dev/null 2>&1 &  {HOOK_MARK}')
# Kept inside .git, so none of it is ever committed.
STATE_FILE = "briefings-copy.json"
LOG_FILE = "briefings-copy.log"
LOCK_FILE = "briefings-copy.lock"
AGAIN_FILE = "briefings-copy.again"


class _Run:
    """One sync: what it said, kept for `mirror` to show later."""

    def __init__(self, quiet):
        self.quiet = quiet
        self.lines = []

    def say(self, msg):
        self.lines.append(msg)
        if not self.quiet:
            print(msg, flush=True)

    def save(self):
        try:
            stamp = time.strftime("%Y-%m-%d %H:%M")
            git_path(LOG_FILE).write_text(
                "\n".join(f"{stamp}  {line}" for line in self.lines) + "\n", encoding="utf-8")
        except (OSError, SystemExit):
            pass

    def fail(self, msg):
        global _run
        _run = None
        self.say(f"Not sent: {msg}")
        self.save()
        raise SystemExit(1)


def git(*args):
    out = subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True)
    if out.returncode != 0:
        die(f"git {args[0]} failed: {(out.stderr or out.stdout).strip()}")
    return out.stdout


def git_path(name):
    """A file inside this repository's .git folder."""
    return (ROOT / git("rev-parse", "--git-path", name).strip()).resolve()


def _try_lock(handle):
    if fcntl is not None:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except OSError:
            return False
    import msvcrt
    try:
        msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
        return True
    except OSError:
        return False


def load_bundle():
    """The index, each task's page and every page's top bar, drawn read-only by
    this workspace's own proxy code, so the copy looks exactly like home."""
    source = ROOT / "_askai" / "server.py"
    if not source.is_file():
        die("this workspace has no _askai/server.py, so there is no index to copy.")
    spec = importlib.util.spec_from_file_location("askai_server_for_copy", source)
    module = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(module)
    except Exception as exc:          # a broken proxy is not a reason to crash
        die(f"could not load _askai/server.py ({exc}).")
    if not hasattr(module, "mirror_bundle"):
        die("this workspace's _askai/server.py is too old to draw the copy. Update the "
            "workspace (git pull upstream main) and run this again.")
    try:
        return module.mirror_bundle()
    except Exception as exc:
        die(f"drawing the index failed ({exc}).")


def copy_files(bundle):
    """Every file the copy holds, and the ones left out for being too big.

    What git tracks in the task folders, inside submodules too; every page the
    index shows, even one not committed yet; and the index's own page code.
    """
    tracked = git("ls-files", "-z", "--recurse-submodules", "--", *COPY_DIRS).split("\0")
    wanted = ({p for p in tracked if p} | set(bundle.get("crumbs") or {})
              | {f"_askai/{name}" for name in COPY_UI})
    root = ROOT.resolve()
    keep, too_big = [], []
    for rel in sorted(wanted):
        parts = rel.split("/")
        name = parts[-1].lower()
        if (any(not p or p == ".." or p.startswith(".") for p in parts)
                or SKIP_PARTS & set(parts) or name.endswith(SKIP_SUFFIXES)
                or ".sqlite3" in name):
            continue
        path = ROOT / rel
        # A link could point anywhere on this computer. Only real files inside
        # the workspace are sent.
        if path.is_symlink() or not path.is_file() or not path.resolve().is_relative_to(root):
            continue
        size = path.stat().st_size
        if size > MAX_FILE_BYTES:
            too_big.append((rel, size))
            continue
        keep.append(rel)
    return keep, too_big


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def hash_files(paths, known):
    """{path: [sha256, size]}, reading only files whose size or time changed."""
    manifest, seen = {}, {}
    for rel in paths:
        stat = (ROOT / rel).stat()
        hit = known.get(rel)
        if isinstance(hit, list) and len(hit) == 3 and hit[:2] == [stat.st_mtime_ns, stat.st_size]:
            digest = hit[2]
        else:
            digest = sha256_file(ROOT / rel)
        seen[rel] = [stat.st_mtime_ns, stat.st_size, digest]
        manifest[rel] = [digest, stat.st_size]
    return manifest, seen


def sync_once(run, token):
    state_path = git_path(STATE_FILE)
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        state = {}

    bundle = load_bundle()
    paths, too_big = copy_files(bundle)
    manifest, seen = hash_files(paths, state.get("hashes") or {})
    mark = hashlib.sha256(json.dumps([manifest, bundle, host()], sort_keys=True)
                          .encode("utf-8")).hexdigest()
    if state.get("fingerprint") == mark:
        run.say(f"Nothing has changed since the last copy: {state.get('url', '')}")
        return

    status, body = api("/api/publish/workspace/plan", {"files": manifest}, token=token)
    if status != 200:
        run.fail(refused(status, body, "briefings.page would not take the list of files"))
    missing = body.get("missing") or []
    first = {}
    for rel, (digest, _) in manifest.items():
        first.setdefault(digest, rel)
    if missing:
        size = sum(manifest[first[d]][1] for d in missing)
        run.say(f"Sending {len(missing)} file{'' if len(missing) == 1 else 's'}, "
                f"{size / 1_000_000:.1f} MB.")
    for digest in missing:
        data = (ROOT / first[digest]).read_bytes()
        if hashlib.sha256(data).hexdigest() != digest:
            # Changed while this was running. Go round again with the new bytes.
            git_path(AGAIN_FILE).touch()
            run.say(f"{first[digest]} changed while it was being sent, so the copy starts again.")
            return
        status, body = api(f"/api/publish/workspace/blobs/{digest}", raw=data,
                           token=token, method="PUT", timeout=300)
        if status != 201:
            run.fail(refused(status, body, f"{first[digest]} was not taken"))

    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT,
                          capture_output=True, text=True).stdout.strip()
    status, body = api("/api/publish/workspace/commit", {
        "files": manifest, "bundle": bundle, "head": head,
        "source": socket.gethostname(),
    }, token=token, timeout=300)
    if status != 200:
        run.fail(refused(status, body, "the new copy was not saved"))

    state_path.write_text(json.dumps({
        "fingerprint": mark, "hashes": seen, "url": body.get("url"),
        "synced_at": time.time(),
    }), encoding="utf-8")
    run.say(f"Your copy is up to date: {body.get('url')}")
    run.say(f"{body.get('files')} files, {body.get('pages')} pages. This time: "
            f"{body.get('added', 0)} new, {body.get('changed', 0)} changed, "
            f"{body.get('removed', 0)} removed.")
    for rel, size in too_big:
        run.say(f"Left out, over {MAX_FILE_BYTES // (1024 * 1024)} MB: {rel} "
                f"({size / 1_000_000:.1f} MB)")


def cmd_sync(quiet=False):
    """Send the copy now. From a git hook it runs with --quiet and writes what
    happened to .git/briefings-copy.log instead of the terminal."""
    global _run
    run = _Run(quiet)
    token = saved_token()
    if not token:
        if quiet:
            _run = run
            die("this workspace is not signed in to briefings.page. Run ./bin/publish mirror on.")
        token = token_or_sign_in()
    _run = run

    lock = open(git_path(LOCK_FILE), "a")
    if not _try_lock(lock):
        # One is already sending. It looks for this file when it finishes and
        # goes round once more, so this change is not lost.
        git_path(AGAIN_FILE).touch()
        _run = None
        if not quiet:
            print("A copy is already being sent; it will include this change too.")
        return
    try:
        for _ in range(5):
            git_path(AGAIN_FILE).unlink(missing_ok=True)
            sync_once(run, token)
            if not git_path(AGAIN_FILE).exists():
                break
        run.save()
    finally:
        _run = None
        lock.close()


def _is_shell(first_line):
    words = first_line[2:].split() if first_line.startswith("#!") else []
    if words and words[0].endswith("/env"):
        words = words[1:]
    return bool(words) and os.path.basename(words[0]) in ("sh", "bash", "zsh", "dash")


def hooks_on():
    for name in HOOKS:
        path = git_path(f"hooks/{name}")
        text = path.read_text(encoding="utf-8") if path.exists() else "#!/bin/sh\n"
        if HOOK_MARK in text:
            continue
        first = text.splitlines()[0] if text.strip() else ""
        if first and not _is_shell(first):
            die(f"{path} is not a shell script, so add this line to it yourself:\n  {HOOK_LINE}")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text.rstrip("\n") + "\n" + HOOK_LINE + "\n", encoding="utf-8")
        path.chmod(path.stat().st_mode | 0o111)


def hooks_off():
    for name in HOOKS:
        path = git_path(f"hooks/{name}")
        if path.exists():
            kept = [line for line in path.read_text(encoding="utf-8").splitlines()
                    if HOOK_MARK not in line]
            path.write_text("\n".join(kept) + "\n", encoding="utf-8")


def hooks_are_on():
    for name in HOOKS:
        path = git_path(f"hooks/{name}")
        if not path.exists() or HOOK_MARK not in path.read_text(encoding="utf-8"):
            return False
    return True


def cmd_mirror(rest):
    what = rest[0] if rest else "status"
    if what == "on":
        token_or_sign_in()
        hooks_on()
        print("The copy is on. It is sent to briefings.page after every commit and every merge.\n")
        cmd_sync(quiet=False)
        print(f"\nOnly you can open it. Choose which pages are public at "
              f"{host()}/publish/workspace/")
    elif what == "off":
        hooks_off()
        print("The copy is off. Nothing more is sent after commits.")
        print(f"What is already on briefings.page stays; delete it at {host()}/publish/workspace/")
    elif what == "status":
        print(f"Sent after every commit: {'yes' if hooks_are_on() else 'no'}")
        token = saved_token()
        if token:
            status, body = api("/api/publish/workspace", token=token)
            if status == 200 and body.get("synced_at"):
                print(f"On briefings.page: {body['files']} files, "
                      f"{body['bytes'] / 1_000_000:.0f} of {body['max_bytes'] / 1_000_000:.0f} MB, "
                      f"last sent {body['synced_at'][:16].replace('T', ' ')} UTC")
                print(f"Open it at: {body['url']}")
            elif status == 200:
                print("On briefings.page: nothing yet.")
            else:
                print(refused(status, body, "Could not ask briefings.page"))
        log = git_path(LOG_FILE)
        if log.exists():
            print("\nLast run:")
            print(log.read_text(encoding="utf-8").rstrip())
    else:
        die("mirror takes on, off or nothing at all.")


USAGE = """publish - put a deliverable online with its Ask AI drawer working

  ./bin/publish <file.html>   publish it, or update it if already published
  ./bin/publish list          what is online right now
  ./bin/publish rm <id>       take one down and free its slot
  ./bin/publish whoami        which account this workspace publishes to

  ./bin/publish mirror on     keep a private copy of the whole workspace on
                              briefings.page, sent again after every commit
  ./bin/publish mirror off    stop sending it
  ./bin/publish mirror        where the copy stands
  ./bin/publish sync          send the copy now, once

The first run opens a browser to set up an account. Nothing to copy or paste.
Published pages are public to anyone with the link - never publish client
material, credentials, or personal data. The workspace copy is private: only
you can open it, until you make one of its pages public.
"""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    command, rest = argv[0], argv[1:]
    if command == "list":
        cmd_list()
    elif command == "whoami":
        cmd_whoami()
    elif command == "rm":
        if not rest:
            die("which page? Run ./bin/publish list to see the ids.")
        cmd_rm(rest[0])
    elif command == "sync":
        cmd_sync(quiet="--quiet" in rest)
    elif command == "mirror":
        cmd_mirror(rest)
    else:
        cmd_publish(command)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
