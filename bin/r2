#!/usr/bin/env bash
#
# r2 — email-scoped file storage on any S3-compatible service.
#
# Every write lands under your own folder ($R2_USER_EMAIL), so a mistyped path
# can only ever hit your own files. That matters because R2 has no object
# versioning: an overwrite or delete is permanent and immediate, with no trash
# and no restore.
#
# This stops accidents, not people. Anyone holding the token can still run
# `aws s3` directly against any folder. Accidents are the realistic risk.
#
# `share` hands out a signed link that expires (1 day by default) rather than
# a permanent public URL, so a leaked link stops working on its own. That only
# holds if no custom domain is serving the bucket — if one is, the script says
# so, because then the expiry is decoration.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

die() { printf 'r2: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
r2 — email-scoped uploads to Cloudflare R2

  r2 put   <file> [dest]   store in your own folder
  r2 share <file> [dest]   store + print a signed link that expires
  r2 link  <path> [secs]   re-issue a signed link for something already there
  r2 ls    [prefix]        list your folder
  r2 rm    <path>          delete one file inside your folder

A dest ending in "/" is treated as a folder; otherwise it is the filename.
Share links last 1 day by default — set R2_SHARE_TTL in .env to change it
(7 days is the maximum any signed URL can last).
EOF
}

command -v aws >/dev/null 2>&1 || die "aws CLI not found — brew install awscli"
[ -f "$ROOT/.env" ] || die "no .env — run ./setup.sh, then fill it in"

set -a; . "$ROOT/.env"; set +a

# Cloud storage is optional — a workspace can be entirely local. Fail with a
# useful sentence rather than a stack of missing-variable errors.
if [ -z "${R2_ACCESS_KEY_ID:-}${R2_SECRET_KEY:-}${R2_ENDPOINT:-}" ]; then
  die "file storage isn't set up for this workspace.
    Large files just stay on your machine, which is fine.
    To enable it, open Claude Code here and say: set up my storage"
fi

[ -n "${R2_USER_EMAIL:-}" ]    || die "set R2_USER_EMAIL in .env — it becomes your folder name"
[ -n "${R2_ACCESS_KEY_ID:-}" ] || die "R2_ACCESS_KEY_ID is empty in .env"
[ -n "${R2_SECRET_KEY:-}" ]    || die "R2_SECRET_KEY is empty in .env"
[ -n "${R2_ENDPOINT:-}" ]      || die "R2_ENDPOINT is empty in .env"
case "$R2_ENDPOINT" in
  *ACCOUNT_ID*) die "R2_ENDPOINT still has the ACCOUNT_ID placeholder — put your real account id in .env" ;;
esac

BUCKET_PRIVATE="${R2_BUCKET_PRIVATE:-assistant}"
BUCKET_PUBLIC="${R2_BUCKET_PUBLIC:-$BUCKET_PRIVATE}"

# How long a `share` link stays alive. One day by default; SigV4 caps at 7.
SHARE_TTL="${R2_SHARE_TTL:-86400}"
[ "$SHARE_TTL" -le 604800 ] 2>/dev/null || die "R2_SHARE_TTL cannot exceed 604800 (7 days) — that's a signing limit, not ours"

# A public base URL means a custom domain is serving this bucket to the open
# internet, so nothing in it is private. Empty is the safe configuration:
# `share` presigns instead, and links expire on their own.
PUBLIC_BASE="${R2_PUBLIC_BASE:-}"

ME="$R2_USER_EMAIL"
# Public links use only the local part, to keep full addresses off the open web.
PUB_NS="share/${ME%%@*}"

export AWS_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="$R2_SECRET_KEY"
export AWS_DEFAULT_REGION=auto

s3() { command aws s3 --endpoint-url "$R2_ENDPOINT" "$@"; }

human_ttl() {
  if   [ "$1" -ge 86400 ]; then printf '%s day(s)'    "$(( $1 / 86400 ))"
  elif [ "$1" -ge 3600 ];  then printf '%s hour(s)'   "$(( $1 / 3600 ))"
  else                          printf '%s minute(s)' "$(( $1 / 60 ))"
  fi
}

# Reject anything that could climb out of the prefix.
# Must be called as a statement in the main shell: a `die` inside $( ) would
# only exit the subshell and let the caller carry on with an empty string.
check() {
  case "${1:-}" in
    *..*) die "'..' is not allowed in paths" ;;
  esac
}

# Build a destination key. Assumes check() has already vetted $3.
key_for() {
  local prefix="$1" src="$2" dest="${3:-}"
  dest="${dest#/}"
  if [ -z "$dest" ]; then
    printf '%s/%s' "$prefix" "$(basename "$src")"
  elif [ "${dest: -1}" = "/" ]; then
    printf '%s/%s%s' "$prefix" "$dest" "$(basename "$src")"
  else
    printf '%s/%s' "$prefix" "$dest"
  fi
}

cmd="${1:-help}"; shift || true

case "$cmd" in
  put)
    [ $# -ge 1 ] || die "usage: r2 put <file> [dest]"
    [ -f "$1" ] || die "no such file: $1"
    check "${2:-}"
    key="$(key_for "$ME" "$1" "${2:-}")"
    s3 cp "$1" "s3://$BUCKET_PRIVATE/$key" \
      || die "upload failed — does bucket '$BUCKET_PRIVATE' exist and is it in your token's scope?"
    printf '\nstored  s3://%s/%s\n' "$BUCKET_PRIVATE" "$key"
    if [ -n "$PUBLIC_BASE" ]; then
      printf 'NOTE: a public domain serves this bucket, so this is readable by anyone with the URL:\n  %s/%s\n' "$PUBLIC_BASE" "$key"
    fi
    ;;

  share)
    [ $# -ge 1 ] || die "usage: r2 share <file> [dest]"
    [ -f "$1" ] || die "no such file: $1"
    check "${2:-}"
    key="$(key_for "$PUB_NS" "$1" "${2:-}")"
    s3 cp "$1" "s3://$BUCKET_PUBLIC/$key" \
      || die "upload failed — does bucket '$BUCKET_PUBLIC' exist and is it in your token's scope?"
    url=$(command aws s3 presign "s3://$BUCKET_PUBLIC/$key" \
            --endpoint-url "$R2_ENDPOINT" --expires-in "$SHARE_TTL") \
      || die "could not sign a link for $key"
    printf '\nLink, valid for %s:\n  %s\n' "$(human_ttl "$SHARE_TTL")" "$url"
    printf '\nAnyone holding it can open it until then — no login. Re-issue later with:\n  r2 link %s\n' "$key"
    if [ -n "$PUBLIC_BASE" ]; then
      printf '\nWARNING: a public domain also serves this bucket, so the file is reachable\nwithout the signed link and the expiry buys you nothing:\n  %s/%s\n' "$PUBLIC_BASE" "$key"
    fi
    ;;

  link)
    [ $# -ge 1 ] || die "usage: r2 link <path-in-bucket> [seconds]"
    check "$1"
    ttl="${2:-$SHARE_TTL}"
    [ "$ttl" -le 604800 ] 2>/dev/null || die "max is 604800 (7 days)"
    url=$(command aws s3 presign "s3://$BUCKET_PUBLIC/${1#/}" \
            --endpoint-url "$R2_ENDPOINT" --expires-in "$ttl") \
      || die "could not sign a link for $1"
    printf 'Link, valid for %s:\n  %s\n' "$(human_ttl "$ttl")" "$url"
    ;;

  ls)
    check "${1:-}"
    p="${1:-}"; p="${p#/}"
    s3 ls "s3://$BUCKET_PRIVATE/$ME/$p"
    ;;

  rm)
    [ $# -ge 1 ] || die "usage: r2 rm <path>   (inside your folder only)"
    check "$1"
    p="${1#/}"
    printf 'delete s3://%s/%s/%s ? [y/N] ' "$BUCKET_PRIVATE" "$ME" "$p"
    read -r ok
    [ "$ok" = "y" ] || die "aborted"
    s3 rm "s3://$BUCKET_PRIVATE/$ME/$p"
    ;;


  help|--help|-h)
    usage
    printf '\nyou are: %s\n  your folder:  s3://%s/%s/\n  shared under: s3://%s/%s/\n  links expire: %s\n' \
      "$ME" "$BUCKET_PRIVATE" "$ME" "$BUCKET_PUBLIC" "$PUB_NS" "$(human_ttl "$SHARE_TTL")"
    if [ -n "$PUBLIC_BASE" ]; then
      printf '  WARNING: %s serves this bucket publicly — nothing in it is private\n' "$PUBLIC_BASE"
    fi
    ;;

  *) die "unknown command '$cmd' — try: r2 help" ;;
esac
